#!/usr/bin/env bash
# ============================================================================
# procforge-update: atualiza o ProcForge para a última release publicada.
#
#   procforge-update                 checa e atualiza (pergunta antes)
#   procforge-update --check         só mostra a versão instalada e a última
#   procforge-update --yes           atualiza sem perguntar (usado pela GUI)
#   procforge-update --version 0.5.0 instala uma versão específica
#
# Detecta como o ProcForge foi instalado e atualiza do jeito certo:
#   appimage  troca o arquivo .AppImage pelo novo
#   pacman    pkexec pacman -U   (pacote .pkg.tar.zst da release)
#   rpm       pkexec dnf install (pacote .rpm da release)
#   deb       pkexec apt-get install (pacote .deb da release)
#   source    baixa o código-fonte da release, compila e reinstala a GUI no
#             mesmo prefixo (ex.: ~/.local) e o helper em /usr via pkexec
# Todo arquivo baixado é conferido contra o SHA256SUMS publicado na release.
#
# Variáveis para teste: PROCFORGE_RELEASES_API (JSON no formato da API do
# GitHub), PROCFORGE_GITLAB_API, PROCFORGE_UPDATE_NO_HELPER=1.
# ============================================================================
set -euo pipefail

GITHUB_API="${PROCFORGE_RELEASES_API:-https://api.github.com/repos/gabrielmf1998/ProcForge/releases}"
GITLAB_API="${PROCFORGE_GITLAB_API:-https://gitlab.com/api/v4/projects/gabriel17166%2FProcForge/releases}"
UA="ProcForge-updater"

MODE=update
ASSUME_YES=0
WANT_VERSION=""
BINARY=""
CURRENT=""
KIND=""
PREFIX=""

say()  { printf '==> %s\n' "$*"; }
warn() { printf '  ! %s\n' "$*" >&2; }
die()  { printf 'ERRO: %s\n' "$*" >&2; exit 1; }

while [ $# -gt 0 ]; do
    case "$1" in
        --check)    MODE=check ;;
        --detect)   MODE=detect ;;
        --yes|-y)   ASSUME_YES=1 ;;
        --version)  WANT_VERSION="${2:-}"; shift ;;
        --binary)   BINARY="${2:-}"; shift ;;
        --current)  CURRENT="${2:-}"; shift ;;
        --kind)     KIND="${2:-}"; shift ;;
        --prefix)   PREFIX="${2:-}"; shift ;;
        -h|--help)  sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) die "opção desconhecida: $1" ;;
    esac
    shift
done
WANT_VERSION="${WANT_VERSION#v}"

[ "$(id -u)" -ne 0 ] || die "rode como seu usuário, não como root (o pkexec pede a senha só onde precisa)."

# ---------------------------------------------------------------- detecção --
if [ -z "$BINARY" ]; then
    if [ -n "${APPIMAGE:-}" ]; then BINARY="$APPIMAGE"
    else BINARY="$(command -v procforge || true)"; fi
fi
[ -n "$BINARY" ] || die "não encontrei o executável procforge (use --binary)."
BINARY="$(readlink -f "$BINARY")"

detect_kind() {
    if [ -n "${APPIMAGE:-}" ] && [ -f "$APPIMAGE" ]; then echo appimage; return; fi
    case "$BINARY" in *.AppImage|*.appimage) echo appimage; return ;; esac
    if command -v pacman >/dev/null 2>&1 && pacman -Qqo "$BINARY" >/dev/null 2>&1; then echo pacman; return; fi
    if command -v dpkg >/dev/null 2>&1 && dpkg -S "$BINARY" >/dev/null 2>&1; then echo deb; return; fi
    if command -v rpm >/dev/null 2>&1 && rpm -qf "$BINARY" >/dev/null 2>&1; then echo rpm; return; fi
    echo source
}
[ -n "$KIND" ] || KIND="$(detect_kind)"
if [ "$MODE" = detect ]; then echo "$KIND"; exit 0; fi

if [ -z "$CURRENT" ]; then
    CURRENT="$(timeout 10 "$BINARY" --version 2>/dev/null | awk 'NR==1 {print $NF}' || true)"
fi
CURRENT="${CURRENT#v}"

# ------------------------------------------------------------ última versão --
command -v curl >/dev/null 2>&1 || die "curl não encontrado."
fetch() { curl -fsSL --retry 2 --connect-timeout 15 -A "$UA" "$@"; }

ASSET_URLS=""   # "nome url" por linha
TAG=""
release_github() {
    local json url
    if [ -n "$WANT_VERSION" ]; then url="$GITHUB_API/tags/v$WANT_VERSION"; else url="$GITHUB_API/latest"; fi
    json="$(fetch "$url")" || return 1
    TAG="$(printf '%s' "$json" | grep -o '"tag_name": *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')"
    ASSET_URLS="$(printf '%s' "$json" | grep -o '"browser_download_url": *"[^"]*"' \
                  | sed 's/.*"\(http[^"]*\)"$/\1/' | while read -r u; do printf '%s %s\n' "${u##*/}" "$u"; done)"
    [ -n "$TAG" ]
}
release_gitlab() {
    local json url
    if [ -n "$WANT_VERSION" ]; then url="$GITLAB_API/v$WANT_VERSION"; else url="$GITLAB_API?per_page=1"; fi
    json="$(fetch "$url")" || return 1
    TAG="$(printf '%s' "$json" | grep -o '"tag_name": *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')"
    ASSET_URLS="$(printf '%s' "$json" | grep -o '"direct_asset_url": *"[^"]*"' \
                  | sed 's/.*"\(http[^"]*\)"$/\1/' | while read -r u; do printf '%s %s\n' "${u##*/}" "$u"; done)"
    [ -n "$TAG" ]
}
say "Consultando a última versão publicada..."
if ! release_github; then
    warn "GitHub indisponível, tentando o GitLab"
    release_gitlab || die "não consegui consultar as releases no GitHub nem no GitLab."
fi
LATEST="${TAG#v}"

ver_gt() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; }

echo "Instalado: ${CURRENT:-desconhecido} ($KIND, $BINARY)"
echo "Disponível: $LATEST"
if [ "$MODE" = check ]; then
    if [ -n "$CURRENT" ] && ! ver_gt "$LATEST" "$CURRENT"; then echo "Já está na versão mais recente."; fi
    exit 0
fi
if [ -z "$WANT_VERSION" ] && [ -n "$CURRENT" ] && ! ver_gt "$LATEST" "$CURRENT"; then
    echo "Já está na versão mais recente."
    echo "PROCFORGE-UPDATE-UPTODATE $CURRENT"
    exit 0
fi
if [ "$ASSUME_YES" -ne 1 ]; then
    printf 'Atualizar para %s? [s/N] ' "$LATEST"
    read -r ans || ans=""
    case "$ans" in s|S|y|Y|sim|yes) ;; *) echo "Cancelado."; exit 1 ;; esac
fi

# ------------------------------------------------------------- download -----
WORK="$(mktemp -d "${TMPDIR:-/tmp}/procforge-update.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT

asset_url() { printf '%s\n' "$ASSET_URLS" | awk -v n="$1" '$1==n {print $2; exit}'; }
asset_match() { printf '%s\n' "$ASSET_URLS" | awk '{print $1}' | grep -E "$1" | head -1; }

download_verified() {   # $1 = nome do asset
    local name="$1" url
    url="$(asset_url "$name")"
    [ -n "$url" ] || die "a release $LATEST não tem o arquivo $name."
    say "Baixando $name"
    fetch -o "$WORK/$name" "$url" || die "falha ao baixar $name."
    ( cd "$WORK" && awk -v n="$name" '$2==n || $2=="*"n' SHA256SUMS | grep -q . \
        && awk -v n="$name" '$2==n || $2=="*"n' SHA256SUMS | sha256sum -c --status ) \
        || die "SHA256 de $name NÃO confere com o SHA256SUMS da release. Nada foi instalado."
    echo "  sha256 ok"
}

sums_url="$(asset_url SHA256SUMS)"
[ -n "$sums_url" ] || die "a release $LATEST não publica SHA256SUMS; recusando instalar sem verificação."
fetch -o "$WORK/SHA256SUMS" "$sums_url" || die "falha ao baixar SHA256SUMS."

# -------------------------------------------------------------- instalação --
case "$KIND" in
appimage)
    name="ProcForge-$LATEST-x86_64.AppImage"
    download_verified "$name"
    target="${APPIMAGE:-$BINARY}"
    [ -w "$(dirname "$target")" ] || die "sem permissão de escrita em $(dirname "$target")."
    chmod +x "$WORK/$name"
    cp -f "$WORK/$name" "$target.new" && mv -f "$target.new" "$target"
    say "AppImage atualizado em $target"
    warn "o AppImage traz só a GUI; se você instalou o helper à parte, rode o install-helper.sh da nova versão."
    ;;
pacman)
    name="procforge-$LATEST-1-x86_64.pkg.tar.zst"
    download_verified "$name"
    say "Instalando o pacote (pkexec pede sua senha)"
    pkexec pacman -U --noconfirm "$WORK/$name"
    ;;
rpm)
    name="$(asset_match "^procforge-$LATEST-1\..*x86_64\.rpm\$")"
    [ -n "$name" ] || die "a release $LATEST não tem pacote .rpm."
    download_verified "$name"
    if command -v rpm-ostree >/dev/null 2>&1 && [ -e /run/ostree-booted ]; then
        die "sistema atômico (rpm-ostree): baixe $name da página da release e aplique com rpm-ostree; a troca automática não é feita aqui."
    fi
    say "Instalando o pacote (pkexec pede sua senha)"
    pkexec dnf install -y "$WORK/$name"
    ;;
deb)
    name="procforge_$LATEST-1_amd64.deb"
    download_verified "$name"
    say "Instalando o pacote (pkexec pede sua senha)"
    pkexec apt-get install -y "$WORK/$name"
    ;;
source)
    case "$BINARY" in */bin/procforge) ;; *)
        die "este procforge ($BINARY) não está numa pasta bin/ instalada (pasta de compilação?). Atualize com git pull e recompile." ;;
    esac
    name="procforge-$LATEST.tar.gz"
    download_verified "$name"
    for t in cmake g++ tar; do command -v "$t" >/dev/null 2>&1 || die "falta a ferramenta '$t' para compilar."; done
    say "Extraindo e compilando (isso leva cerca de um minuto)"
    tar -xzf "$WORK/$name" -C "$WORK"
    SRC="$WORK/procforge-$LATEST"
    [ -f "$SRC/CMakeLists.txt" ] || die "tarball inesperado (sem CMakeLists.txt)."
    gen=(); command -v ninja >/dev/null 2>&1 && gen=(-G Ninja)
    cmake -S "$SRC" -B "$SRC/build" "${gen[@]}" -DCMAKE_BUILD_TYPE=Release -DPROCFORGE_BUILD_TESTS=OFF >/dev/null
    nice -n 10 cmake --build "$SRC/build" --parallel "$(nproc 2>/dev/null || echo 2)"
    [ -n "$PREFIX" ] || PREFIX="$(dirname "$(dirname "$BINARY")")"
    say "Instalando a GUI em $PREFIX"
    bash "$SRC/scripts/install-local.sh" --prefix "$PREFIX" --build "$SRC/build"
    if [ "${PROCFORGE_UPDATE_NO_HELPER:-0}" != 1 ]; then
        say "Instalando o helper privilegiado (pkexec pede sua senha)"
        pkexec bash "$SRC/install-helper.sh" || die "o helper não foi atualizado (autorização negada?). A GUI já está na versão nova; rode de novo para tentar o helper."
    fi
    ;;
*) die "tipo de instalação desconhecido: $KIND" ;;
esac

say "ProcForge atualizado para $LATEST."
echo "PROCFORGE-UPDATE-OK $LATEST"
